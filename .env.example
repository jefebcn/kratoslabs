# Copia in .env.local e compila. Nessun segreto va committato.

# URL pubblico del sito (usato per metadata e sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canale community (link nel footer e nella sezione trust)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/kratoslabs

# --- Autenticazione Supabase (login/registrazione live) ---
# Da Supabase: Project Settings -> API. Sono pubbliche (finiscono nel bundle).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email che possono accedere a /admin (separate da virgola). Solo lato server.
# In alternativa, imposta il ruolo "admin" nei metadati dell'utente su Supabase.
ADMIN_EMAILS=

# --- Da collegare negli step successivi (DB prodotti, pagamenti) ---
DATABASE_URL=
STRIPE_SECRET_KEY=
