# Copia in .env.local e compila. Nessun segreto va committato.

# URL pubblico del sito (usato per metadata e sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canale community (link nel footer e nella sezione trust)
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/kratoslabs

# --- Autenticazione Supabase (login/registrazione live) ---
# Da Supabase: Project Settings -> API. Sono pubbliche (finiscono nel bundle).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email che possono accedere a /admin (separate da virgola). Solo lato server.
# In alternativa, imposta il ruolo "admin" nei metadati dell'utente su Supabase.
ADMIN_EMAILS=

# --- Pagamenti in criptovaluta (checkout) ---
# Indirizzi di RICEZIONE (pubblici). Se vuoti, il checkout non mostra alcun
# indirizzo pagabile (nessun rischio di inviare a un indirizzo sbagliato).
NEXT_PUBLIC_BTC_ADDRESS=
NEXT_PUBLIC_USDT_TRC20_ADDRESS=

# --- Pagamento con bonifico bancario (checkout) ---
# Dati per ricevere il bonifico (pubblici). Se IBAN/intestatario mancano, il
# checkout non mostra coordinate bancarie.
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_HOLDER=
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_BIC=

# --- Ordini lato server (Supabase) ---
# Service role key: SOLO server, bypassa la RLS per creare ordini in sicurezza.
SUPABASE_SERVICE_ROLE_KEY=

# --- Da collegare negli step successivi (DB prodotti) ---
DATABASE_URL=
